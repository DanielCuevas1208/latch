%% rebar3 configuration for the latch application.
%%
%% Latch is a small, dependency-free library.
%% Build and test with: rebar3 compile && rebar3 eunit

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{escript_name, latch}.
{escript_main_app, latch}.
{escript_incl_apps, [latch]}.

{cover_enabled, true}.

{dialyzer, [
    {warnings, [error_handling, unmatched_returns]}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]},
    {prod, [
        {erl_opts, [no_debug_info]}
    ]}
]}.
